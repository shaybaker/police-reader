{
  "name": "police-reader",
  "version": "0.5.0",
  "description": "תחנת למידה משחקית לקריאה וכתיבה",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "package:win": "electron-builder --win nsis portable"
  },
  "devDependencies": {
    "electron": "^32.1.2",
    "electron-builder": "^25.0.5"
  },
  "build": {
    "appId": "il.police.reader",
    "productName": "תחנת קריאה משטרתית",
    "files": [
      "main.js",
      "index.html",
      "styles.css",
      "app.js",
      "assets/**/*"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "artifactName": "${productName}-Setup-${version}-${arch}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "תחנת קריאה משטרתית",
      "menuCategory": "לימודים"
    },
    "portable": {
      "artifactName": "${productName}-Portable-${version}-${arch}.${ext}"
    }
  }
}
