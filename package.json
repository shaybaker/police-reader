{
  "name": "police-reader",
  "version": "0.1.0",
  "description": "תחנת למידה משחקית לקריאה וכתיבה",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "package:win": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "^32.1.2",
